#!/usr/bin/env php
<?php
declare(strict_types=1);

foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../src/autoload.php'] as $f) {
    if (is_file($f)) {
        require $f;
        break;
    }
}

exit(\Linearjeph\Prophecy\Cli::run(array_slice($argv, 1)));
