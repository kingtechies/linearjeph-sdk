{
  "name": "@linearjeph/sdk",
  "version": "1.2.0",
  "description": "Revenue forecasting and growth analytics (Prophecy: MRR/ARR projection, churn, feature impact) plus error tracking, performance, logs and cron monitoring for Node.js. Zero dependencies.",
  "keywords": [
    "revenue-forecasting",
    "mrr",
    "arr",
    "saas-metrics",
    "churn",
    "cohort-analysis",
    "product-analytics",
    "growth-analytics",
    "feature-analytics",
    "forecasting",
    "error-tracking",
    "apm",
    "monitoring",
    "express",
    "nextjs",
    "prophecy",
    "linearjeph"
  ],
  "homepage": "https://linearjeph.cc/prophecy",
  "bugs": {
    "email": "support@linearjeph.cc",
    "url": "https://linearjeph.cc/help"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingtechies/linearjeph-sdk.git",
    "directory": "node"
  },
  "license": "MIT",
  "author": {
    "name": "LINEARJEPH",
    "email": "support@linearjeph.cc",
    "url": "https://linearjeph.cc"
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./prophecy": {
      "types": "./prophecy.d.ts",
      "import": "./prophecy.mjs",
      "require": "./prophecy.cjs",
      "default": "./prophecy.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "linearjeph": "./bin/linearjeph.cjs"
  },
  "files": [
    "index.cjs",
    "telemetry.cjs",
    "prophecy.cjs",
    "prophecy-scan.cjs",
    "prophecy.mjs",
    "prophecy.d.ts",
    "bin/linearjeph.cjs",
    "index.mjs",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
